{
  "name": "ai-agent-electron",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Cross-platform Electron desktop shell for AI Agent",
  "main": "dist/main.mjs",
  "scripts": {
    "dev": "npm run build:renderer && npm run build:main && electron .",
    "build:main": "esbuild main.ts --bundle --platform=node --format=esm --external:electron --outfile=dist/main.mjs --sourcemap && esbuild preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload.cjs --sourcemap",
    "build:renderer": "node scripts/copy-renderer.mjs",
    "build": "npm run build:renderer && npm run build:main",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:mac": "npm run build && electron-builder --mac --arm64 --dir",
    "dist:linux": "npm run build && electron-builder --linux",
    "typecheck": "tsc --noEmit"
  },
  "build": {
    "appId": "com.youjunmao.ai-agent",
    "productName": "AI Agent",
    "afterPack": "scripts/after-pack.mjs",
    "directories": {
      "output": "../dist/releases/app",
      "buildResources": "../desktop/assets"
    },
    "files": ["dist/**/*", "package.json"],
    "asar": true,
    "win": { "target": [{ "target": "nsis", "arch": ["x64", "arm64"] }] },
    "mac": {
      "icon": "app-icon.icns",
      "category": "public.app-category.developer-tools"
    },
    "linux": { "target": ["AppImage"], "category": "Development" }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  }
}
