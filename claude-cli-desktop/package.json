{
  "name": "claude-cli-desktop",
  "version": "0.1.12",
  "private": true,
  "type": "module",
  "description": "A local Electron desktop client for Claude Code CLI",
  "main": "dist/main.mjs",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "npm run build:renderer && npm run build:main",
    "build:main": "esbuild electron/main.ts --bundle --platform=node --format=esm --external:electron --external:@anthropic-ai/claude-agent-sdk --outfile=dist/main.mjs && esbuild electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload.cjs",
    "build:renderer": "node scripts/copy-renderer.mjs",
    "typecheck": "tsc --noEmit",
    "dist:mac": "npm run build && electron-builder --mac --arm64 --dir --publish=never"
  },
  "build": {
    "appId": "com.youjunmao.claude-cli-studio",
    "productName": "Claude CLI Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.2.112"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  }
}
